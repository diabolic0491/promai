POSTGRES_DB=promai
POSTGRES_USER=promai
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg://promai:change-me@postgres:5432/promai

APP_NAME=PromAI API
APP_VERSION=0.1.0
APP_ENVIRONMENT=development
DEBUG=false
AUTH_SECRET_KEY=
AUTH_ISSUER=promai-api
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=7

CONTRACT_ANALYSIS_ENABLED=true
CONTRACT_ANALYSIS_API_BASE_URL=http://host.docker.internal:11434/v1
CONTRACT_ANALYSIS_MODEL=qwen3.5:4b
CONTRACT_ANALYSIS_API_KEY=ollama
CONTRACT_ANALYSIS_TIMEOUT_SECONDS=180
CONTRACT_ANALYSIS_BATCH_MAX_CHARACTERS=6000
CONTRACT_ANALYSIS_MAX_OUTPUT_TOKENS=1600
CONTRACT_ANALYSIS_POLICY_PATH=/app/config/contract_analysis_policy.v1.json

FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
